{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Per-call usage receipt (not a run record until source evidence exists)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "record_id",
    "physical_call_id",
    "experiment_id",
    "task_id",
    "split",
    "strategy",
    "logical_strategies",
    "stage",
    "attempt",
    "parent_call_id",
    "request_id",
    "response_id",
    "thread_id",
    "turn_id",
    "requested_model",
    "confirmed_model",
    "requested_effort",
    "confirmed_effort",
    "requested_speed",
    "confirmed_speed",
    "model_evidence_ref",
    "rerouted",
    "status",
    "receipt_status",
    "source",
    "scope",
    "billable_calls_in_scope",
    "source_contract_ref",
    "event_ids",
    "reset_boundary_id",
    "input_tokens",
    "output_tokens",
    "cache_read_tokens",
    "cache_write_tokens",
    "reasoning_output_tokens",
    "total_tokens",
    "input_semantics",
    "output_semantics",
    "cache_categories_disjoint",
    "raw_usage",
    "raw_usage_sha256",
    "availability_notes",
    "started_at_utc",
    "ended_at_utc",
    "elapsed_seconds",
    "billing_mode",
    "actual_api_charge_usd",
    "charge_evidence_ref",
    "quota_window_id",
    "quota_delta",
    "quota_precision",
    "tools_charge_usd",
    "usage_field_paths"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "record_kind": {
      "enum": [
        "synthetic",
        "observed"
      ]
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "physical_call_id": {
      "type": "string",
      "minLength": 1
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "calibration",
        "eval",
        "probe",
        "synthetic"
      ]
    },
    "strategy": {
      "enum": [
        "W-only",
        "E-only",
        "W-to-E",
        "shared-W-initial"
      ]
    },
    "logical_strategies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "W-only",
          "E-only",
          "W-to-E"
        ]
      }
    },
    "stage": {
      "enum": [
        "initial",
        "repair",
        "takeover",
        "consultation",
        "application",
        "probe"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "parent_call_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "response_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "thread_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "turn_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "requested_model": {
      "type": "string",
      "minLength": 1
    },
    "confirmed_model": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "requested_effort": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "confirmed_effort": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "requested_speed": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "confirmed_speed": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "model_evidence_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "rerouted": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "cancelled",
        "incomplete",
        "unknown"
      ]
    },
    "receipt_status": {
      "enum": [
        "final",
        "provisional",
        "unavailable"
      ]
    },
    "source": {
      "enum": [
        "server_usage",
        "documented_runtime_event",
        "synthetic",
        "unavailable"
      ]
    },
    "scope": {
      "enum": [
        "request",
        "turn",
        "thread",
        "account",
        "unknown"
      ]
    },
    "billable_calls_in_scope": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "source_contract_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reset_boundary_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "output_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cache_read_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cache_write_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "reasoning_output_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "total_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "input_semantics": {
      "enum": [
        "includes_cache",
        "excludes_cache",
        "unknown"
      ]
    },
    "output_semantics": {
      "enum": [
        "includes_reasoning",
        "excludes_reasoning",
        "unknown"
      ]
    },
    "cache_categories_disjoint": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "raw_usage": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/safeCounterTree"
      }
    },
    "raw_usage_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "availability_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "started_at_utc": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "ended_at_utc": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "elapsed_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "billing_mode": {
      "enum": [
        "subscription",
        "api",
        "synthetic",
        "unknown"
      ]
    },
    "actual_api_charge_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "charge_evidence_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "quota_window_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "quota_delta": {
      "type": [
        "number",
        "null"
      ]
    },
    "quota_precision": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "tools_charge_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "usage_field_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "reasoning_output_tokens",
        "total_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^/"
        },
        "output_tokens": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^/"
        },
        "cache_read_tokens": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^/"
        },
        "cache_write_tokens": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^/"
        },
        "reasoning_output_tokens": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^/"
        },
        "total_tokens": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^/"
        }
      }
    }
  },
  "$defs": {
    "safeCounterTree": {
      "anyOf": [
        {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/safeCounterTree"
          }
        }
      ]
    }
  }
}
